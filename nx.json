{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/vite.config.ts"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "@nx/js:node": {
      "options": {
        "watch": true,
        "inspect": false,
        "runBuildTargetDependencies": true,
        "runtimeArgs": ["--enable-source-maps"]
      }
    },
    "test": {
      "inputs": ["default", "^production"],
      "options": { "args": ["--run"] },
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "options": { "args": ["--max-warnings=0"] },
      "cache": true
    },
    "openapi": {
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/api/openapi.json"],
      "cache": true
    },
    "test-typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build", "^build"],
      "inputs": ["default", "^production"],
      "cache": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": { "targetName": "lint" }
    },
    {
      "plugin": "@nx/vitest",
      "options": { "testTargetName": "test" }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": ["packages/**", "blueprints/*/packages/**"],
      "options": {
        "typecheck": false,
        "verboseOutput": true,
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": ["apps/**", "blueprints/*/apps/**"],
      "options": {
        "typecheck": false,
        "verboseOutput": true,
        "build": {
          "targetName": "build",
          "configName": "tsconfig.app.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ],
  "analytics": false
}
