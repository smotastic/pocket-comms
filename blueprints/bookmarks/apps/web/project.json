{
  "name": "bookmarks-web",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "blueprints/bookmarks/apps/web/src",
  "projectType": "application",
  "tags": ["scope:bookmarks", "type:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "tsc -p tsconfig.app.json --noEmit && vite build",
        "cwd": "{projectRoot}"
      }
    },
    "routes-check": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/routes/**/*",
        "{projectRoot}/src/routeTree.gen.ts",
        "{projectRoot}/tsr.config.json",
        "{workspaceRoot}/tools/routes/check.mjs",
        { "externalDependencies": ["@tanstack/router-cli"] }
      ],
      "cache": true,
      "options": { "command": "node ../../../../tools/routes/check.mjs", "cwd": "{projectRoot}" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["bookmarks-server"], "target": "dev" }],
      "continuous": true,
      "options": { "command": "vite --host", "cwd": "{projectRoot}" }
    },
    "dev-memory": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["bookmarks-server"], "target": "dev-memory" }],
      "continuous": true,
      "options": { "command": "vite --host", "cwd": "{projectRoot}" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": { "command": "vite preview --host", "cwd": "{projectRoot}" }
    },
    "lint": { "dependsOn": ["routes-check"] },
    "test-typecheck": {}
  }
}
