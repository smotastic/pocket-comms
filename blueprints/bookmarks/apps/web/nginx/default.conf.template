# Rendered by the nginx image's entrypoint (envsubst); only the variables set in the environment
# are replaced, so nginx's own `$` variables stay as they are.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # A variable upstream makes nginx resolve the name at request time instead of at startup.
    set $bookmarks_server http://${BOOKMARKS_SERVER_HOST}:${BOOKMARKS_SERVER_PORT};

    location ~ ^/(api|docs|health)(/|$) {
        proxy_pass $bookmarks_server;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets never change; the HTML entry point must always be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
