{
  "name": "bookmarks-server",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "blueprints/bookmarks/apps/server/src",
  "projectType": "application",
  "tags": ["scope:bookmarks", "type:app"],
  "targets": {
    "migrate": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --enable-source-maps dist/migrate.js",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "local": {
          "env": {
            "DATABASE_URL": "postgres://bookmarks:bookmarks@localhost:5432/bookmarks",
            "PORT": "3001"
          }
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/openapi.js && prettier --write api/openapi.json",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --enable-source-maps dist/main.js",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "local": {
          "env": {
            "DATABASE_URL": "postgres://bookmarks:bookmarks@localhost:5432/bookmarks",
            "PORT": "3001"
          }
        }
      }
    },
    "db-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ../../../../tools/dev/docker-check.mjs && docker compose -f ../../docker-compose.yml up -d --wait",
        "cwd": "{projectRoot}"
      }
    },
    "db-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f ../../docker-compose.yml down",
        "cwd": "{projectRoot}"
      }
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose -f ../../docker-compose.yml down -v",
        "cwd": "{projectRoot}"
      }
    },
    "migrate-dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "db-up"],
      "options": {
        "command": "node --enable-source-maps dist/migrate.js",
        "cwd": "{projectRoot}",
        "env": {
          "DATABASE_URL": "postgres://bookmarks:bookmarks@localhost:5432/bookmarks"
        }
      }
    },
    "seed-dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "migrate-dev"],
      "options": {
        "command": "node --enable-source-maps dist/seed.js",
        "cwd": "{projectRoot}",
        "env": {
          "DATABASE_URL": "postgres://bookmarks:bookmarks@localhost:5432/bookmarks"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "seed-dev"],
      "continuous": true,
      "options": {
        "commands": [
          "tsc --build tsconfig.app.json --watch --preserveWatchOutput",
          "node --enable-source-maps --watch dist/main.js"
        ],
        "parallel": true,
        "cwd": "{projectRoot}",
        "env": {
          "DATABASE_URL": "postgres://bookmarks:bookmarks@localhost:5432/bookmarks",
          "PORT": "3001"
        }
      }
    },
    "dev-memory": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "commands": [
          "tsc --build tsconfig.app.json --watch --preserveWatchOutput",
          "node --enable-source-maps --watch dist/main.memory.js"
        ],
        "parallel": true,
        "cwd": "{projectRoot}",
        "env": {
          "PORT": "3001"
        }
      }
    },
    "test-typecheck": {}
  }
}
