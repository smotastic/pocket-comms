              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            },
            "description": "A stored bookmark.",
            "headers": {
              "etag": {
                "required": true,
                "schema": {
                  "description": "The version of the returned bookmark as a strong entity tag.",
                  "examples": ["\"1\""],
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundProblemEncoded"
                }
              }
            },
            "description": "The resource does not exist."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemEncoded"
                }
              }
            },
            "description": "The request is invalid. `errors` names every failed field."
          }
        },
        "security": [],
        "summary": "Get a bookmark",
        "tags": ["Bookmarks"]
      },
      "patch": {
        "description": "Changes the URL, the title or the tags. Requires If-Match (428 without it). An archived bookmark cannot change (409).",
        "operationId": "bookmarks.update",
        "parameters": [
          {
