            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The id of the bookmark.",
              "examples": ["0192f3a1-7b2c-7d3e-8f40-123456789abc"],
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
              "type": "string"
            }
          },
          {
            "description": "The ETag of the version the change is based on. Another current version fails with 412.",
            "example": "\"1\"",
            "in": "header",
            "name": "if-match",
            "required": false,
            "schema": {
              "description": "The ETag of the version the change is based on. Another current version fails with 412.",
