  "info": {
    "description": "The reference service of the template: bookmarks with tags and versions.",
    "title": "Bookmarks API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/bookmarks": {
      "get": {
        "description": "Lists bookmarks newest first, by tag and status, in pages. `next` is present when more bookmarks follow.",
        "operationId": "bookmarks.list",
        "parameters": [
          {
            "description": "Returns only the bookmarks with this tag.",
            "example": "docs",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "description": "Returns only the bookmarks with this tag.",
              "examples": ["docs"],
              "maxLength": 30,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          {
            "description": "Returns the bookmarks with this status; `active` when missing.",
            "example": "active",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "description": "Returns the bookmarks with this status; `active` when missing.",
              "enum": ["active", "archived", "all"],
              "examples": ["active"],
              "type": "string"
            }
          },
          {
            "description": "An opaque cursor from `next` of the previous page. Do not build it yourself.",
            "example": "eyJjcmVhdGVkQXQiOiIyMDI2LTA5LTI5VDA4OjAwOjAwLjAwMFoiLCJpZCI6IjAxOTJmM2ExLTdiMmMtN2QzZS04ZjQwLTEyMzQ1Njc4OWFiYyJ9",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "An opaque cursor from `next` of the previous page. Do not build it yourself.",
              "examples": [
                "eyJjcmVhdGVkQXQiOiIyMDI2LTA5LTI5VDA4OjAwOjAwLjAwMFoiLCJpZCI6IjAxOTJmM2ExLTdiMmMtN2QzZS04ZjQwLTEyMzQ1Njc4OWFiYyJ9"
              ],
              "type": "string"
            }
          },
          {
            "description": "The page size, 1 to 100; 20 when missing.",
            "example": "20",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "The page size, 1 to 100; 20 when missing.",
              "examples": ["20"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookmarkPage"
                }
              }
            },
            "description": "One page of bookmarks."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemEncoded"
                }
              }
            },
            "description": "The request is invalid. `errors` names every failed field."
          }
        },
        "security": [],
        "summary": "List bookmarks",
        "tags": ["Bookmarks"]
      },
      "post": {
        "description": "Creates a bookmark at version 1. A URL can belong to one bookmark only.",
        "operationId": "bookmarks.create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookmarkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bookmark"
                }
              }
            },
            "description": "A stored bookmark.",
            "headers": {
              "etag": {
                "required": true,
                "schema": {
                  "description": "The version of the returned bookmark as a strong entity tag.",
                  "examples": ["\"1\""],
                  "type": "string"
                }
              },
              "location": {
                "required": true,
                "schema": {
                  "description": "The path of the created bookmark.",
                  "examples": ["/api/v1/bookmarks/0192f3a1-7b2c-7d3e-8f40-123456789abc"],
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConflictProblemEncoded"
                }
              }
            },
            "description": "The request conflicts with the current state of the resource."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemEncoded"
                }
              }
            },
            "description": "The request is invalid. `errors` names every failed field."
          }
        },
        "security": [],
        "summary": "Create a bookmark",
        "tags": ["Bookmarks"]
      }
    },
    "/api/v1/bookmarks/{id}": {
      "delete": {
        "description": "Deletes a bookmark for good, also an archived one. If-Match is optional.",
        "operationId": "bookmarks.delete",
        "parameters": [
          {
            "description": "The id of the bookmark.",
            "example": "0192f3a1-7b2c-7d3e-8f40-123456789abc",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The id of the bookmark.",
              "examples": ["0192f3a1-7b2c-7d3e-8f40-123456789abc"],
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
              "type": "string"
            }
          },
          {
            "description": "The ETag of the version the change is based on. Another current version fails with 412.",
            "example": "\"1\"",
            "in": "header",
            "name": "if-match",
            "required": false,
            "schema": {
              "description": "The ETag of the version the change is based on. Another current version fails with 412.",
              "examples": ["\"1\""],
              "pattern": "^\"[1-9][0-9]*\"$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundProblemEncoded"
                }
              }
            },
            "description": "The resource does not exist."
          },
          "412": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/PreconditionFailedProblemEncoded"
                }
              }
            },
            "description": "The If-Match header does not match the current version."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemEncoded"
                }
              }
            },
            "description": "The request is invalid. `errors` names every failed field."
          }
        },
        "security": [],
        "summary": "Delete a bookmark",
        "tags": ["Bookmarks"]
      },
      "get": {
        "description": "Returns one bookmark.",
        "operationId": "bookmarks.get",
        "parameters": [
          {
            "description": "The id of the bookmark.",
            "example": "0192f3a1-7b2c-7d3e-8f40-123456789abc",
