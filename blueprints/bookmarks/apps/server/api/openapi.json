            "examples": ["No bookmark has the id 0192f3a1-7b2c-7d3e-8f40-123456789abc."],
            "type": "string"
          },
          "errors": {
            "description": "Every failed field of the request.",
            "examples": [
              [
                {
                  "field": "tags",
                  "message": "Expected an array of at most 3 items"
