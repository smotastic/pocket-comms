{
  "space": {
    "$type": "dimension",
    "3xs": {
      "$value": "{size.2}"
    },
    "2xs": {
      "$value": "{size.4}"
    },
    "xs": {
      "$value": "{size.6}"
    },
    "sm": {
      "$value": "{size.8}"
    },
    "md": {
      "$value": "{size.12}"
    },
    "lg": {
      "$value": "{size.16}"
    },
    "xl": {
      "$value": "{size.24}"
    },
    "2xl": {
      "$value": "{size.32}"
    },
    "3xl": {
      "$value": "{size.48}"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "{size.8}"
    },
    "md": {
      "$value": "{size.10}"
    },
    "lg": {
      "$value": "{size.16}"
    },
    "full": {
      "$value": "{size.9999}"
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "default": {
        "$value": "{size.1}"
      },
      "focus": {
        "$value": "{size.2}"
      }
    }
  },
  "control": {
    "height": {
      "$type": "dimension",
      "md": {
        "$value": "{size.44}",
        "$description": "The smallest tap target."
      }
    }
  },
  "layout": {
    "width": {
      "$type": "dimension",
      "page": {
        "$value": "{size.720}"
      }
    },
    "height": {
      "$type": "dimension",
      "sheet-gap": {
        "$value": "{size.96}",
        "$description": "The room above a bottom sheet, where the screen behind it shows."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": "{fontFamily.inter}"
      },
      "mono": {
        "$value": "{fontFamily.jetbrains-mono}",
        "$description": "Code, commands, paths and terminal output."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "{fontSize.12}"
      },
      "sm": {
        "$value": "{fontSize.13}"
      },
      "md": {
        "$value": "{fontSize.14}"
      },
      "base": {
        "$value": "{fontSize.16}"
      },
      "lead": {
        "$value": "{fontSize.17}",
        "$description": "One step above body, such as a sheet's title."
      },
      "lg": {
        "$value": "{fontSize.20}"
      },
      "xl": {
        "$value": "{fontSize.28}"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": "{fontWeight.400}"
      },
      "medium": {
        "$value": "{fontWeight.500}"
      },
      "bold": {
        "$value": "{fontWeight.600}"
      }
    },
    "lineHeight": {
      "$type": "number",
      "body": {
        "$value": 1.5
      },
      "tight": {
        "$value": 1.2
      },
      "display": {
        "$value": 1,
        "$description": "A single line set in a box of its own size, such as an avatar's initials."
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": {
        "$value": "{letterSpacing.tight}"
      },
      "label": {
        "$value": "{letterSpacing.label}",
        "$description": "Opens up small uppercase labels."
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.150}"
      },
      "medium": {
        "$value": "{duration.280}",
        "$description": "Something that moves into place, such as a sheet rising."
      },
      "pulse": {
        "$value": "{duration.1200}",
        "$description": "One beat of a repeating activity animation."
      },
      "hold": {
        "$value": "{duration.600}",
        "$description": "A long press that confirms a costly action, such as Ctrl-C."
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}"
      },
      "decelerate": {
        "$value": "{easing.decelerate}",
        "$description": "Fast then settling, for something that arrives."
      },
      "linear": {
        "$value": "{easing.linear}",
        "$description": "An even pace, for progress that tracks time."
      }
    }
  },
  "color": {
    "$type": "color",
    "terminal": {
      "$description": "A terminal screen; it stays dark in both themes.",
      "bg": {
        "$value": "{color.ink.950}"
      },
      "fg": {
        "$value": "{color.ink.200}"
      },
      "ansi": {
        "black": {
          "$value": "{color.ansi.0}"
        },
        "red": {
          "$value": "{color.ansi.1}"
        },
        "green": {
          "$value": "{color.ansi.2}"
        },
        "yellow": {
          "$value": "{color.ansi.3}"
        },
        "blue": {
          "$value": "{color.ansi.4}"
        },
        "magenta": {
          "$value": "{color.ansi.5}"
        },
        "cyan": {
          "$value": "{color.ansi.6}"
        },
        "white": {
          "$value": "{color.ansi.7}"
        },
        "bright-black": {
          "$value": "{color.ansi.8}"
        },
        "bright-red": {
          "$value": "{color.ansi.9}"
        },
        "bright-green": {
          "$value": "{color.ansi.10}"
        },
        "bright-yellow": {
          "$value": "{color.ansi.11}"
        },
        "bright-blue": {
          "$value": "{color.ansi.12}"
        },
        "bright-magenta": {
          "$value": "{color.ansi.13}"
        },
        "bright-cyan": {
          "$value": "{color.ansi.14}"
        },
        "bright-white": {
          "$value": "{color.ansi.15}"
        }
      }
    }
  }
}
