{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.gray.950}"
      },
      "surface": {
        "$value": "{color.gray.900}"
      },
      "accent": {
        "$value": "{color.indigo.400}"
      },
      "accent-hover": {
        "$value": "{color.indigo.300}"
      },
      "accent-soft": {
        "$value": "{color.indigo.900}"
      },
      "danger-soft": {
        "$value": "{color.red.950}"
      },
      "sheet": {
        "$value": "{color.gray.900}",
        "$description": "A bottom sheet over the screen."
      },
      "scrim": {
        "$value": "{color.navy.950.60}",
        "$description": "Dims the screen behind a sheet."
      },
      "success-soft": {
        "$value": "{color.green.950}"
      },
      "neutral-soft": {
        "$value": "{color.gray.800}",
        "$description": "A quiet fill, such as an idle status."
      },
      "bar": {
        "$value": "{color.gray.950-80}",
        "$description": "A bar that stays on top while the page scrolls beneath it."
      },
      "kind-claude": {
        "$value": "{color.orange.950}"
      },
      "kind-pi": {
        "$value": "{color.yellow.950}"
      }
    },
    "text": {
      "default": {
        "$value": "{color.gray.100}"
      },
      "muted": {
        "$value": "{color.gray.400}"
      },
      "accent": {
        "$value": "{color.indigo.400}"
      },
      "on-accent": {
        "$value": "{color.indigo.950}"
      },
      "danger": {
        "$value": "{color.red.400}"
      },
      "success": {
        "$value": "{color.green.400}"
      },
      "kind-claude": {
        "$value": "{color.orange.300}"
      },
      "kind-pi": {
        "$value": "{color.yellow.300}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.800}"
      },
      "focus": {
        "$value": "{color.indigo.400}"
      },
      "control": {
        "$value": "{color.gray.500}",
        "$description": "The edge of a field that must stand out from its surface."
      },
      "danger": {
        "$value": "{color.red.400-45}",
        "$description": "The edge of something that needs the reader, such as a blocked agent."
      },
      "success": {
        "$value": "{color.green.400-35}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": [
        {
          "color": "{color.transparent}",
          "offsetX": "{size.0}",
          "offsetY": "{size.0}",
          "blur": "{size.0}",
          "spread": "{size.0}"
        }
      ]
    }
  }
}
