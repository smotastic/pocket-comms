{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.gray.50}"
      },
      "surface": {
        "$value": "{color.white}"
      },
      "accent": {
        "$value": "{color.indigo.600}"
      },
      "accent-hover": {
        "$value": "{color.indigo.700}"
      },
      "accent-soft": {
        "$value": "{color.indigo.50}"
      },
      "danger-soft": {
        "$value": "{color.red.50}"
      },
      "sheet": {
        "$value": "{color.white}",
        "$description": "A bottom sheet over the screen."
      },
      "scrim": {
        "$value": "{color.navy.950.40}",
        "$description": "Dims the screen behind a sheet."
      },
      "success-soft": {
        "$value": "{color.green.50}"
      },
      "neutral-soft": {
        "$value": "{color.gray.100}",
        "$description": "A quiet fill, such as an idle status."
      },
      "bar": {
        "$value": "{color.gray.50-80}",
        "$description": "A bar that stays on top while the page scrolls beneath it."
      }
    },
    "text": {
      "default": {
        "$value": "{color.gray.850}"
      },
      "muted": {
        "$value": "{color.gray.500}"
      },
      "accent": {
        "$value": "{color.indigo.600}"
      },
      "on-accent": {
        "$value": "{color.white}"
      },
      "danger": {
        "$value": "{color.red.600}"
      },
      "success": {
        "$value": "{color.green.700}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.200}"
      },
      "focus": {
        "$value": "{color.indigo.600}"
      },
      "control": {
        "$value": "{color.gray.500}",
        "$description": "The edge of a field that must stand out from its surface."
      },
      "danger": {
        "$value": "{color.red.400-45}",
        "$description": "The edge of something that needs the reader, such as a blocked agent."
      },
      "success": {
        "$value": "{color.green.400-35}"
      }
    },
    "project": {
      "$description": "A project's colour: the edge of its rows and its label. Projects take them in turn.",
      "1": {
        "$value": "{color.sky.700}"
      },
      "2": {
        "$value": "{color.pink.700}"
      },
      "3": {
        "$value": "{color.teal.700}"
      },
      "4": {
        "$value": "{color.orange.700}"
      },
      "5": {
        "$value": "{color.violet.700}"
      },
      "neutral": {
        "$value": "{color.gray.500}",
        "$description": "A project without a colour of its own, and an agent without a project."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": [
        {
          "color": "{color.navy.950.6}",
          "offsetX": "{size.0}",
          "offsetY": "{size.1}",
          "blur": "{size.2}",
          "spread": "{size.0}"
        },
        {
          "color": "{color.navy.950.8}",
          "offsetX": "{size.0}",
          "offsetY": "{size.1}",
          "blur": "{size.3}",
          "spread": "{size.0}"
        }
      ]
    }
  }
}
