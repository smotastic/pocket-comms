{
  "$schema": "./node_modules/syncpack/schema.json",
  "strict": true,
  "customTypes": {
    "optional": { "path": "optionalDependencies", "strategy": "versionsByName" }
  },
  "versionGroups": [
    {
      "label": "Internal workspace packages use workspace:*",
      "dependencies": ["$LOCAL"],
      "dependencyTypes": ["prod", "dev", "peer"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "External dependencies use the pnpm default catalog",
      "dependencyTypes": ["prod", "dev", "peer"],
      "policy": "catalog"
    }
  ]
}
