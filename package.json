{
  "name": "pocket-comms",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smotastic/pocket-comms.git"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "nx run-many -t dev --output-style=stream",
    "dev:memory": "nx run-many -t dev-memory --output-style=stream",
    "dev:down": "nx run-many -t db-down",
    "dev:reset": "nx run-many -t db-reset",
    "build": "nx affected:build",
    "test": "nx affected --target=test",
    "lint": "nx affected --target=lint",
    "test-typecheck": "nx affected --target=test-typecheck",
    "dep-cruise": "depcruise --config .dependency-cruiser.cjs apps packages blueprints",
    "test:boundaries": "node --test tools/boundaries/*.test.mjs",
    "openapi:check": "node tools/openapi/check.mjs",
    "openapi:lint": "node tools/openapi/lint.mjs",
    "openapi:diff": "node tools/openapi/diff.mjs",
    "test:openapi": "node --test tools/openapi/*.test.mjs",
    "ports:check": "node tools/ports/check.mjs",
    "test:ports": "node --test tools/ports/*.test.mjs",
    "tokens:check": "node tools/design-tokens/check.mjs",
    "test:tokens": "node --test tools/design-tokens/*.test.mjs",
    "syncpack:lint": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "validate:conventions": "node tools/conventions/validate.mjs",
    "test:conventions": "node --test tools/conventions/*.test.mjs",
    "test:dev": "node --test tools/dev/*.test.mjs",
    "template:init": "node tools/template/init.mjs",
    ".format": "prettier \"**/*.{ts,mjs,cjs,json,md,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format": "pnpm .format --write",
    "format:check": "pnpm .format --check",
    "verify:local": "bash tools/verify-local.sh"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@eslint/js": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/vitest": "catalog:",
    "@redocly/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-declaration-strict-value": "catalog:",
    "syncpack": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
