{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./out-tsc/spec",
    "tsBuildInfoFile": "./out-tsc/spec/tsconfig.spec.tsbuildinfo",
    "types": ["vite/client", "vitest/globals"]
  },
  // The app sources are checked here too: the web build bundles with Vite and emits no
  // declarations that a project reference could use.
  "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
