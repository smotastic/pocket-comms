{
  "name": "comms-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/comms-web/src",
  "projectType": "application",
  "tags": ["scope:comms", "type:web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "options": {
        "command": "tsc -p tsconfig.app.json --noEmit && vite build",
        "cwd": "{projectRoot}"
      }
    },
    "routes-check": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/routes/**/*",
        "{projectRoot}/src/routeTree.gen.ts",
        "{projectRoot}/tsr.config.json",
        { "externalDependencies": ["@tanstack/router-cli"] }
      ],
      "cache": true,
      "options": { "command": "pnpm exec pocket-ci routes", "cwd": "{projectRoot}" }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["comms-server"], "target": "dev" }],
      "continuous": true,
      "options": { "command": "vite", "cwd": "{projectRoot}" }
    },
    "lint": { "dependsOn": ["routes-check"] },
    "test-typecheck": {}
  }
}
