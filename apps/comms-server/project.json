{
  "name": "comms-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/comms-server/src",
  "projectType": "application",
  "tags": ["scope:comms", "type:app"],
  "targets": {
    "openapi": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/openapi.js && prettier --write api/openapi.json",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "node --enable-source-maps dist/main.js",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "commands": [
          "tsc --build tsconfig.app.json --watch --preserveWatchOutput",
          "node --enable-source-maps --watch dist/main.js"
        ],
        "parallel": true,
        "cwd": "{projectRoot}"
      }
    },
    "test-typecheck": {}
  }
}
