{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(*colima-pocket-cloud*)",
      "Bash(colima stop*)",
      "Bash(colima delete*)",
      "Bash(docker compose down*)",
      "Bash(docker-compose down*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push *:main)",
      "Bash(git push *:master)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/master)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * tag *)",
      "Bash(git push *refs/tags/*)",
      "Bash(tea *--login local*)",
      "Bash(tea *-l local*)"
    ]
  }
}
